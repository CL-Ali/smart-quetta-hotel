# ── Database ─────────────────────────────────────────────────────────────────
# Replace with your actual MySQL connection string
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production

# Required for signing session JWTs — use any long random string locally
JWT_SECRET=change-me-to-a-long-random-secret

# ── OAuth (optional for local dev) ───────────────────────────────────────────
# Leave blank to skip OAuth login — direct dashboard access still works
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# ── Analytics (optional) ─────────────────────────────────────────────────────
# VITE_ANALYTICS_ENDPOINT=https://your-umami-instance.com
# VITE_ANALYTICS_WEBSITE_ID=your-website-id
